<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Daily Brief — {{ date_str }}</title>
<style>
  body { font-family: Charter, Georgia, serif; max-width: 680px; margin: 0 auto; padding: 24px; color: #1a1a1a; line-height: 1.55; }
  h1 { font-size: 28px; margin-bottom: 4px; border-bottom: 2px solid #1a1a1a; padding-bottom: 6px; }
  h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 1.2px; color: #666; margin-top: 36px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
  h3 { font-size: 19px; margin-top: 28px; margin-bottom: 6px; line-height: 1.3; }
  .topic-tag { display: inline-block; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #888; margin-bottom: 8px; }
  .summary { font-size: 16px; margin-bottom: 8px; }
  .sources { font-size: 13px; color: #555; margin-bottom: 4px; }
  .sources a { color: #555; text-decoration: underline; margin-right: 8px; }
  .deep-link { display: inline-block; font-size: 13px; margin-top: 6px; color: #b8651a; font-weight: 600; }
  .headline-row { font-size: 14px; padding: 6px 0; border-bottom: 1px solid #eee; }
  .headline-row a { color: #1a1a1a; text-decoration: none; font-weight: 500; }
  .headline-row .src { color: #888; font-size: 12px; margin-left: 6px; }
  .footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid #ddd; color: #888; font-size: 12px; }
  .tldr { background: #fafaf5; padding: 14px 18px; border-left: 3px solid #b8651a; margin-bottom: 24px; }
  .tldr ul { margin: 0; padding-left: 20px; }
  .tldr li { margin-bottom: 4px; }
</style>
</head>
<body>

<h1>Daily Brief</h1>
<div style="color:#888; font-size:13px;">{{ date_str }} · {{ timezone }}</div>

{% if tldr %}
<div class="tldr">
<strong>TL;DR</strong>
<ul>
{% for line in tldr %}<li>{{ line }}</li>{% endfor %}
</ul>
</div>
{% endif %}

{% if deep_stories %}
<h2>Deep Dives</h2>
{% for story in deep_stories %}
<div class="topic-tag">{{ story.topic }}</div>
<h3>{{ story.headline }}</h3>
<div class="summary">{{ story.short_summary }}</div>
<div class="sources">
{% for s in story.sources %}<a href="{{ s.url }}">{{ s.name }}</a>{% endfor %}
</div>
{% if deep_dive_base_url %}
<a class="deep-link" href="{{ deep_dive_base_url }}/{{ story.cluster_id }}.html">Read full analysis →</a>
{% endif %}
{% endfor %}
{% endif %}

{% if short_stories %}
<h2>What Else to Know</h2>
{% for story in short_stories %}
<div class="topic-tag">{{ story.topic }}</div>
<h3 style="font-size:16px;">{{ story.headline }}</h3>
<div class="summary" style="font-size:15px;">{{ story.short_summary }}</div>
<div class="sources">
{% for s in story.sources %}<a href="{{ s.url }}">{{ s.name }}</a>{% endfor %}
</div>
{% endfor %}
{% endif %}

{% if headlines %}
<h2>Skim</h2>
{% for h in headlines %}
<div class="headline-row">
<a href="{{ h.url }}">{{ h.title }}</a><span class="src">— {{ h.source_name }}</span>
</div>
{% endfor %}
{% endif %}

<div class="footer">
Generated by daily-brief · {{ run_stats }}
</div>

</body>
</html>
