<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Daily Brief — {{ date_str }}</title>
<style>
  body { font-family: Charter, 'Source Serif Pro', Georgia, serif; max-width: 640px; margin: 0 auto; padding: 24px; color: #1a1a1a; line-height: 1.55; }
  h1 { font-size: 28px; margin-bottom: 4px; border-bottom: 2px solid #1a1a1a; padding-bottom: 6px; }
  h2 { font-size: 11px; text-transform: uppercase; letter-spacing: 1.4px; color: #888; margin-top: 32px; border-bottom: 1px solid #eee; padding-bottom: 4px; }
  .meta { color: #888; font-size: 13px; margin-bottom: 0; }
  .tldr { background: #fafaf5; padding: 14px 18px; border-left: 3px solid #b8651a; margin: 22px 0 8px; }
  .tldr ul { margin: 0; padding-left: 20px; }
  .tldr li { margin-bottom: 6px; font-size: 15px; }
  .item { padding: 10px 0; border-bottom: 1px solid #f0f0f0; }
  .item:last-child { border-bottom: none; }
  .title { font-size: 16px; font-weight: 600; margin: 0 0 4px; line-height: 1.3; }
  .title a { color: #1a1a1a; text-decoration: none; }
  .title a:hover { color: #b8651a; }
  .deep-link { font-size: 12px; color: #b8651a; font-weight: 600; text-decoration: none; margin-left: 6px; white-space: nowrap; }
  .blurb { font-size: 14px; color: #444; margin: 0 0 4px; }
  .src { font-size: 12px; color: #888; }
  .src a { color: #888; text-decoration: underline; margin-right: 6px; }
  sup { font-size: 0.7em; color: #b8651a; }
  .footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid #ddd; color: #888; font-size: 11px; }
  .archive { display: inline-block; margin-top: 8px; font-size: 13px; color: #b8651a; }
</style>
</head>
<body>

<h1>Daily Brief</h1>
<div class="meta">{{ date_str }} · {{ timezone }}</div>

{% if tldr %}
<div class="tldr">
<strong style="font-size:13px; text-transform:uppercase; letter-spacing:1px; color:#666;">TL;DR</strong>
<ul>
{% for line in tldr %}<li>{{ line }}</li>{% endfor %}
</ul>
</div>
{% endif %}

{% if deep_dive_base_url %}
<a class="archive" href="{{ deep_dive_base_url }}">View today's full archive →</a>
{% endif %}

{% for topic, group in grouped %}
<h2>{{ topic }}</h2>
{% for item in group %}
<div class="item">
<div class="title">
{% if item.is_deep_dive and deep_dive_base_url %}
  <a href="{{ deep_dive_base_url }}/{{ item.cluster_id }}.html">{{ item.headline }}</a>
  <a class="deep-link" href="{{ deep_dive_base_url }}/{{ item.cluster_id }}.html">deep dive ↗</a>
{% else %}
  <a href="{{ item.sources[0].url }}">{{ item.headline }}</a>
{% endif %}
</div>
<div class="blurb">{{ item.short_summary }}</div>
<div class="src">
{% for s in item.sources %}<a href="{{ s.url }}">{{ s.name }}</a>{% endfor %}
</div>
</div>
{% endfor %}
{% endfor %}

{% if headlines %}
<h2>Skim</h2>
{% for h in headlines %}
<div class="item" style="padding:6px 0;">
<a href="{{ h.url }}" style="color:#1a1a1a; text-decoration:none; font-size:14px;">{{ h.title }}</a>
<span class="src" style="margin-left:6px;">— {{ h.source_name }}</span>
</div>
{% endfor %}
{% endif %}

<div class="footer">
Generated by daily-brief · {{ run_stats }}
</div>

</body>
</html>
